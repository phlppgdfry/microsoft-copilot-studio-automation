{
  "components": {
    "schemas": {
      "Decision": {
        "additionalProperties": false,
        "properties": {
          "approved": {
            "title": "Approved",
            "type": "boolean"
          },
          "reason": {
            "maxLength": 500,
            "minLength": 5,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "approved",
          "reason"
        ],
        "title": "Decision",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Proposal": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "pattern": "^(request_missing_documents|schedule_review)$",
            "title": "Action",
            "type": "string"
          },
          "description": {
            "maxLength": 1000,
            "minLength": 10,
            "title": "Description",
            "type": "string"
          },
          "dossier": {
            "pattern": "^SYN-[A-Z0-9-]{1,40}$",
            "title": "Dossier",
            "type": "string"
          },
          "idempotency_key": {
            "maxLength": 100,
            "minLength": 8,
            "title": "Idempotency Key",
            "type": "string"
          }
        },
        "required": [
          "idempotency_key",
          "dossier",
          "action",
          "description"
        ],
        "title": "Proposal",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Copilot Approval Boundary",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
